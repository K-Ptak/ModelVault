{
  "name": "modelvault",
  "productName": "ModelVault",
  "version": "1.0.0",
  "description": "3D printing model library manager with print pricing (STL, 3MF, OBJ, G-code)",
  "main": "main.js",
  "author": {
    "name": "K-Ptak",
    "email": "K-Ptak@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "postinstall": "node scripts/vendor.js",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "three": "^0.187.0"
  },
  "build": {
    "appId": "pl.kptak.modelvault",
    "productName": "ModelVault",
    "copyright": "© K-Ptak",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "renderer/**",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ModelVault-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ModelVault",
      "artifactName": "ModelVault-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "K-Ptak",
        "repo": "ModelVault",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "artifactName": "ModelVault-${version}-mac-${arch}.${ext}",
      "notarize": false
    },
    "dmg": {
      "artifactName": "ModelVault-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "maintainer": "K-Ptak <K-Ptak@users.noreply.github.com>",
      "synopsis": "3D model library manager with print pricing",
      "artifactName": "ModelVault-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "ModelVault",
          "MimeType": "model/stl;model/3mf;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "ModelVault-${version}-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "ModelVault-${version}-linux-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/K-Ptak/ModelVault.git"
  },
  "homepage": "https://github.com/K-Ptak/ModelVault",
  "desktopName": "modelvault.desktop"
}
