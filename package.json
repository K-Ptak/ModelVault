{
  "name": "modelvault",
  "productName": "ModelVault",
  "version": "1.1.0",
  "description": "Menedżer biblioteki modeli 3D do druku (STL, 3MF, OBJ, G-code)",
  "main": "main.js",
  "author": "ModelVault",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "electron": "^45.5.0"
  },
  "build": {
    "appId": "pl.modelvault.app",
    "productName": "ModelVault",
    "files": ["main.js", "preload.js", "renderer/**", "node_modules/three/build/three.module.js", "node_modules/three/build/three.core.js", "node_modules/three/examples/jsm/**", "package.json"],
    "win": { "target": ["portable"] }
  }
}
